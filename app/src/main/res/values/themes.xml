<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat parent is required by AppCompatActivity (used for per-app language switching).
         All UI is Compose; this theme only styles the window before Compose draws. -->
    <style name="Theme.PokerVision" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/felt_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
