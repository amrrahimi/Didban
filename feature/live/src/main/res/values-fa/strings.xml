    <string name="learn_capture">شروع</string>
    <string name="learn_capturing">در حال عکس گرفتن… آرام حرکت دهید</string>
    <string name="learn_retake">عکس‌برداری دوباره</string>
    <string name="learn_send">ارسال عکس‌ها (%1$s)</string>
    <string name="learn_delete_all">حذف عکس‌ها</string>
    <string name="learn_delete_title">همهٔ عکس‌های کارت حذف شود؟</string>
    <string name="learn_delete_body">همهٔ عکس‌هایی که در «یادگیری کارت‌های من» گرفته شده از این گوشی پاک می‌شوند.</string>
    <string name="learn_tips">نکته‌ها: نور خوب، بدون انعکاس نور روی کارت، کل کارت داخل مربع. با ‹ › برگردید یا رد شوید. عکس‌ها تا وقتی «ارسال» را نزنید روی همین گوشی می‌مانند.</string>
    <string name="learn_share_title">ارسال عکس‌های کارت</string>
    <string name="learn_export_failed">ساخت فایل عکس‌ها ممکن نشد. فضای خالی گوشی را بررسی و دوباره تلاش کنید.</string>
